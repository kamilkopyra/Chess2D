<Project Sdk="Microsoft.NET.Sdk">

  <!-- Texel tuning of the evaluation weights (TunableEvaluation). It compiles the same engine sources
       that Unity uses (Assets/Scripts/Engine). See Tools/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Chess2D.Tune</AssemblyName>
    <RootNamespace>Chess2D.Tune</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Engine\**\*.cs" LinkBase="Engine" />
  </ItemGroup>

</Project>
