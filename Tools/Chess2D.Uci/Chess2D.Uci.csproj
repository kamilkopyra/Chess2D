<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console UCI front-end for the Chess2D engine. It compiles the same engine sources
       that Unity uses (Assets/Scripts/Engine), so every bot version can be played in matches. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Chess2D.Uci</AssemblyName>
    <RootNamespace>Chess2D.Uci</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Engine\**\*.cs" LinkBase="Engine" />
  </ItemGroup>

</Project>
